<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Java 17 — PGCP-BDA | Progressive 100 MCQ Mock Test</title>
<style>
:root{color-scheme:dark;--bg:#0b1020;--panel:#121a2c;--panel2:#182238;--line:#293650;--text:#edf2ff;--muted:#9eabc4;--accent:#8ab4ff;--good:#35c98a;--bad:#ff7272;--easy:#35c98a;--med:#f2b84b;--hard:#ff7777}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 15% 0%,#182b4c 0,transparent 38%),var(--bg);color:var(--text);font:15px/1.55 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
.wrap{max-width:1120px;margin:auto;padding:26px 18px 60px}.hero{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:20px}.eyebrow{color:var(--accent);font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.hero h1{font-size:clamp(26px,4vw,38px);line-height:1.12;margin:8px 0}.sub{color:var(--muted);max-width:720px}.pill{border:1px solid var(--line);border-radius:999px;padding:7px 11px;color:var(--muted);font-size:12px;white-space:nowrap}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:20px 0}.stat,.card{background:rgba(18,26,44,.94);border:1px solid var(--line);border-radius:16px}.stat{padding:13px 15px}.stat strong{display:block;font-size:23px}.stat span{color:var(--muted);font-size:12px}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:16px 0}.filter{background:var(--panel);color:var(--muted);border:1px solid var(--line);padding:8px 13px;border-radius:999px;cursor:pointer}.filter.active{color:var(--text);border-color:var(--accent);background:#1b2c49}.spacer{flex:1}
.progress{height:7px;background:#26324a;border-radius:99px;overflow:hidden;margin:10px 0 18px}.progress>div{height:100%;width:0;background:linear-gradient(90deg,#6d9eff,#55d6b0);transition:width .2s}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:16px;align-items:start}.card{padding:22px}.qtop{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:14px}.qnum{font-size:13px;color:var(--muted)}.tag{font-size:11px;font-weight:800;letter-spacing:.04em;padding:4px 9px;border-radius:99px}.tag.Easy{color:var(--easy);background:#12382f}.tag.Medium{color:var(--med);background:#3b3019}.tag.Hard{color:var(--hard);background:#40242a}.topic{color:var(--muted);font-size:12px;margin-bottom:8px}.question{font-size:19px;font-weight:650;line-height:1.45;margin:0 0 18px;white-space:pre-wrap}.question code,.opt code{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;background:#0b1324;border:1px solid #293650;padding:2px 5px;border-radius:5px;font-size:.9em}
.lesson{margin:0 0 16px;padding:12px 14px;background:#10243a;border:1px solid #294b70;border-radius:11px;color:#d5e5fb;font-size:13px}.lesson strong{display:block;color:#9fc5ff;margin-bottom:4px}.stage{font-size:11px;color:var(--accent);font-weight:800;letter-spacing:.06em;text-transform:uppercase;margin-bottom:7px}.options{display:grid;gap:10px}.option{width:100%;text-align:left;display:flex;gap:12px;align-items:flex-start;background:#151f34;color:var(--text);border:1px solid #2a3853;border-radius:12px;padding:13px;cursor:pointer;transition:.15s}.option:hover:not(:disabled){border-color:#719ce8;background:#1b2b47}.letter{flex:0 0 26px;height:26px;border-radius:8px;background:#263653;display:grid;place-items:center;font-weight:800;font-size:12px}.opt{flex:1}.option:disabled{cursor:default;opacity:1}.option.correct{border-color:var(--good);background:#12352e}.option.correct .letter{background:#1c7959}.option.wrong{border-color:var(--bad);background:#3a2029}.option.wrong .letter{background:#843b48}
.explanation{margin-top:8px;padding:10px 12px;border-radius:9px;background:#0e1728;color:#c7d2e7;font-size:13px;border-left:3px solid #526887}.explanation.good{border-left-color:var(--good)}.explanation.bad{border-left-color:var(--bad)}.explanation strong{color:var(--text)}
.feedback{margin-top:16px;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:#101a2c}.feedback.good{border-color:#287d60}.feedback.bad{border-color:#8b3e4b}.feedback b{display:block;margin-bottom:3px}.feedback p{margin:0;color:var(--muted);font-size:13px}
.nav{display:flex;gap:9px;justify-content:space-between;margin-top:20px}.btn{border:1px solid var(--line);border-radius:10px;padding:10px 15px;background:#1a2942;color:var(--text);font-weight:650;cursor:pointer}.btn.primary{background:#3468b9;border-color:#477ed1}.btn:disabled{opacity:.35;cursor:not-allowed}
.side{position:sticky;top:14px}.side h3{margin:0 0 10px;font-size:14px}.side p{color:var(--muted);font-size:12px;margin:0 0 12px}.gridnums{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}.num{padding:7px 0;border-radius:7px;border:1px solid var(--line);background:#111a2b;color:var(--muted);cursor:pointer;font-size:12px}.num.current{border-color:var(--accent);color:white}.num.answered{background:#1c3b36;color:#9ce6c8;border-color:#28664f}.num.incorrect{background:#40232b;color:#ffb4b4;border-color:#78404a}
.legend{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px;color:var(--muted);font-size:11px}.dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px;background:#35c98a}.dot.red{background:#ff7272}.dot.blue{background:#8ab4ff}
.result{display:none;margin-top:18px}.result.show{display:block}.result h2{margin:0 0 5px}.scorebig{font-size:42px;font-weight:800;color:var(--accent)}.review{display:grid;gap:9px;margin-top:15px}.reviewitem{border:1px solid var(--line);border-radius:10px;padding:12px;background:#101a2c}.reviewitem small{color:var(--muted)}.source{color:var(--muted);font-size:12px;border-top:1px solid var(--line);margin-top:22px;padding-top:14px}.hidden{display:none!important}
@media(max-width:800px){.layout{grid-template-columns:1fr}.side{position:static;order:-1}.gridnums{grid-template-columns:repeat(10,1fr)}.stats{grid-template-columns:repeat(2,1fr)}.hero{display:block}.pill{display:inline-block;margin-top:10px}}
@media(max-width:460px){.wrap{padding:18px 12px 40px}.card{padding:16px}.question{font-size:17px}.gridnums{grid-template-columns:repeat(8,1fr)}.nav .btn{padding:9px 11px}}
</style>
</head>
<body>
<div class="wrap">
<header class="hero">
 <div><div class="eyebrow">PGCP-BDA · Java Programming · Java 17</div><h1>Progressive 100-question mock examination</h1><div class="sub">A beginner-friendly Java 17 mock test: first learn the fundamentals, then apply them in code, and finally solve challenging exam-style questions. After each answer, read the explanation for all four options.</div></div>
 <div class="pill">Self-contained · Works offline</div>
</header>
<section class="stats">
 <div class="stat"><strong id="answered">0 / 100</strong><span>Answered</span></div>
 <div class="stat"><strong id="correct">0</strong><span>Correct</span></div>
 <div class="stat"><strong id="accuracy">—</strong><span>Accuracy (answered)</span></div>
 <div class="stat"><strong id="remaining">100</strong><span>Remaining</span></div>
</section>
<div class="toolbar">
 <button class="filter active" data-filter="All">All questions</button><button class="filter" data-filter="Easy">Easy</button><button class="filter" data-filter="Medium">Medium</button><button class="filter" data-filter="Hard">Hard</button>
 <span class="spacer"></span><button class="btn" id="reset">Reset test</button>
</div>
<div class="toolbar" style="margin-top:4px"><span class="pill">Q1–30 · Easy foundations</span><span class="pill">Q31–70 · Medium application</span><span class="pill">Q71–100 · Hard challenge</span></div>
<div class="progress"><div id="progressbar"></div></div>
<div class="layout">
 <main>
  <section class="card" id="quiz">
   <div class="qtop"><span class="qnum" id="qnum">Question 1 of 100</span><span class="tag Easy" id="difficulty">Easy</span></div>
   <div class="topic" id="topic"></div><h2 class="question" id="question"></h2>
   <div id="lesson" class="lesson"></div>
   <div class="options" id="options"></div>
   <div id="feedback"></div>
   <div class="nav"><button class="btn" id="prev">← Previous</button><button class="btn primary" id="next">Next →</button></div>
  </section>
  <section class="card result" id="result"></section>
 </main>
 <aside class="card side">
  <h3>Question navigator</h3><p>Jump to any question. Green = correct, red = incorrect, blue outline = current.</p>
  <div class="gridnums" id="gridnums"></div>
  <div class="legend"><span><i class="dot"></i>Correct</span><span><i class="dot red"></i>Incorrect</span><span><i class="dot blue"></i>Current</span></div>
  <button class="btn primary" id="finish" style="width:100%;margin-top:16px">Finish & view result</button>
 </aside>
</div>
<div class="source">
 <strong>Question-bank note:</strong> This is an original practice set aligned to the uploaded ACTS Pune PGCP-BDA Java Programming teaching guidelines (Java 17). The questions are arranged progressively: 30 Easy, 40 Medium and 30 Hard. Code snippets appear throughout all three stages. These are practice questions, not verified reproductions of a dated C-DAC past examination. Advanced questions and explanations are newly written for practice.
 <br><br><strong>Exam tip:</strong> Do not rush the code questions. Trace one statement at a time, write down variable values, and check the exact method or object being used. The explanations are written for learners who are still building their Java foundations.
</div>
</div>
<script>
const QUESTIONS = [{"topic": "Java platform & JVM", "difficulty": "Easy", "q": "Which component executes Java bytecode?", "opts": ["JVM", "JDK", "javac", "Javadoc"], "ans": 0, "why": ["Correct option: The JVM loads, verifies and executes bytecode.", "Incorrect option: The JDK is the development kit; it includes tools and a runtime.", "Incorrect option: javac compiles source code into bytecode; it does not execute the program.", "Incorrect option: Javadoc generates API documentation."], "lesson": "Think of the JDK as the developer's toolbox, the JVM as the engine that runs bytecode, and javac as the compiler that turns .java source into .class bytecode."}, {"topic": "Java platform & JVM", "difficulty": "Easy", "q": "Which command compiles App.java into bytecode?", "opts": ["java App.java", "javac App.java", "javadoc App.java", "jar App.java"], "ans": 1, "why": ["Incorrect option: `java` launches a class or source-file program; the compiler command is `javac`.", "Correct option: `javac` compiles Java source into `.class` bytecode files.", "Incorrect option: `javadoc` generates documentation from source comments.", "Incorrect option: `jar` packages files into an archive; it is not the Java compiler."], "lesson": "Think of the JDK as the developer's toolbox, the JVM as the engine that runs bytecode, and javac as the compiler that turns .java source into .class bytecode."}, {"topic": "Data types & variables", "difficulty": "Easy", "q": "Which of the following is a primitive type in Java?", "opts": ["String", "Integer", "boolean", "ArrayList"], "ans": 2, "why": ["Incorrect option: `String` is a reference type in `java.lang`.", "Incorrect option: `Integer` is a wrapper class, not a primitive.", "Correct option: `boolean` is one of Java's eight primitive types.", "Incorrect option: `ArrayList` is a class in the Collections Framework."], "lesson": "Primitive variables store simple values such as numbers and booleans. Reference variables store a reference to an object. Fields get default values; local variables must be assigned before use."}, {"topic": "Operators & control flow", "difficulty": "Easy", "q": "Which loop always executes its body at least once?", "opts": ["for", "while", "do-while", "enhanced for"], "ans": 2, "why": ["Incorrect option: A `for` loop may execute zero times if its condition is initially false.", "Incorrect option: A `while` loop checks its condition before entering the body.", "Correct option: A `do-while` checks its condition after executing the body.", "Incorrect option: An enhanced `for` over an empty array/collection executes zero times."], "lesson": "Java evaluates most expressions from left to right. Post-increment uses the old value and then increments; pre-increment increments first. && and || can skip the right-hand expression."}, {"topic": "OOP & object lifecycle", "difficulty": "Easy", "q": "Which keyword creates an object in Java?", "opts": ["alloc", "new", "create", "this"], "ans": 1, "why": ["Incorrect option: `alloc` is not a Java object-creation keyword.", "Correct option: `new` allocates an object/array and invokes the constructor for class instances.", "Incorrect option: `create` is not a Java keyword for object creation.", "Incorrect option: `this` refers to the current object; it does not create one."], "lesson": "A variable holding an object reference does not contain the whole object. Assigning one reference to another copies the reference, so both can point to the same object."}, {"topic": "Encapsulation & access", "difficulty": "Easy", "q": "Which OOP principle hides internal state and exposes controlled operations?", "opts": ["Encapsulation", "Inheritance", "Compilation", "Iteration"], "ans": 0, "why": ["Correct option: Encapsulation bundles state and behaviour and controls access to implementation details.", "Incorrect option: Inheritance models an is-a relationship and reuses/extends behaviour.", "Incorrect option: Compilation translates source code; it is not an OOP pillar.", "Incorrect option: Iteration repeats operations."], "lesson": "Encapsulation protects an object's internal data. private members are accessible inside their declaring class; public members can be accessed wherever the class is accessible."}, {"topic": "Methods & constructors", "difficulty": "Easy", "q": "What is method overloading?", "opts": ["Same method name with different parameter lists", "Same method signature in unrelated classes only", "Changing only the return type", "Defining two constructors with identical parameter lists"], "ans": 0, "why": ["Correct option: Overloading is resolved at compile time and requires a different parameter list.", "Incorrect option: That is not the definition of overloading.", "Incorrect option: Return type alone cannot distinguish overloaded methods.", "Incorrect option: Two constructors with identical parameter lists in one class are a duplicate declaration."], "lesson": "Overloading means the same method name with different parameter lists. Java chooses an overload at compile time. Constructors initialize objects and have the class name with no return type."}, {"topic": "Polymorphism & casting", "difficulty": "Easy", "q": "What is runtime polymorphism in Java most commonly achieved through?", "opts": ["Method overriding and dynamic dispatch", "Method overloading only", "Primitive widening", "Package imports"], "ans": 0, "why": ["Correct option: Overridden instance methods are selected based on the actual object's runtime class.", "Incorrect option: Overloading is resolved at compile time using declared types and arguments.", "Incorrect option: Primitive widening is a conversion rule, not runtime polymorphism.", "Incorrect option: Imports affect name resolution, not dynamic dispatch."], "lesson": "The reference type controls which members are visible at compile time. For overridden instance methods, the actual object's class chooses the implementation at runtime."}, {"topic": "Exception handling", "difficulty": "Easy", "q": "Which is the superclass of most exception and error conditions in Java?", "opts": ["Throwable", "Exception", "RuntimeException", "Object"], "ans": 0, "why": ["Correct option: `Throwable` is the root of Java's exception/error hierarchy.", "Incorrect option: `Exception` is a subclass of Throwable.", "Incorrect option: `RuntimeException` is a subclass of Exception.", "Incorrect option: `Object` is the root of all classes, but not the direct exception-hierarchy root."], "lesson": "An exception interrupts normal flow. A matching catch handles it; finally is used for cleanup. Checked exceptions must be caught or declared, while RuntimeException subclasses are unchecked."}, {"topic": "Strings", "difficulty": "Easy", "q": "How should two String objects be compared for content equality?", "opts": ["==", "equals()", "hashCode() == 0", "instanceof"], "ans": 1, "why": ["Incorrect option: `==` compares reference identity for objects, not String content.", "Correct option: `equals()` compares the character sequence for String values.", "Incorrect option: Hash codes are not a reliable equality test by themselves.", "Incorrect option: `instanceof` tests type compatibility."], "lesson": "String objects cannot be changed after creation. Methods such as concat and toUpperCase return a new String; they do not modify the original String variable automatically."}, {"topic": "Generics & collections", "difficulty": "Easy", "q": "What is the main benefit of generics in collections?", "opts": ["They remove all runtime errors", "They provide compile-time type safety and reduce casts", "They make every collection sorted", "They make collections immutable"], "ans": 1, "why": ["Incorrect option: Generics reduce type errors but cannot eliminate all runtime errors.", "Correct option: Generics let the compiler enforce element types and reduce explicit casts.", "Incorrect option: Ordering depends on the implementation, not generics.", "Incorrect option: Mutability is independent of generic type parameters."], "lesson": "Generics let the compiler check what types a collection can contain. With `? extends T`, reading as T is safe; with `? super T`, adding T is safe."}, {"topic": "Collections - List/Set/Map", "difficulty": "Easy", "q": "Which List implementation provides fast indexed access in typical use?", "opts": ["ArrayList", "LinkedList", "TreeSet", "HashMap"], "ans": 0, "why": ["Correct option: ArrayList is array-backed and offers O(1) indexed access on average.", "Incorrect option: LinkedList requires traversal for indexed access.", "Incorrect option: TreeSet is a Set, not a List.", "Incorrect option: HashMap is a key-value Map."], "lesson": "List keeps elements in a sequence and allows duplicates. Set prevents duplicates. Map stores key-value pairs and each key can map to only one current value."}, {"topic": "Enums, wrappers & annotations", "difficulty": "Easy", "q": "Which keyword declares an enumeration?", "opts": ["enum", "enumeration", "const", "finalenum"], "ans": 0, "why": ["Correct option: `enum` is Java's declaration keyword.", "Incorrect option: `enumeration` is not a Java keyword.", "Incorrect option: `const` is reserved but unused; it does not declare enums.", "Incorrect option: `finalenum` is not a Java keyword."], "lesson": "Enums define a fixed set of named constants. Wrapper classes represent primitive values as objects; autoboxing and unboxing convert between the two forms."}, {"topic": "Functional programming & lambdas", "difficulty": "Easy", "q": "Which annotation marks an interface intended to have one abstract method?", "opts": ["@FunctionalInterface", "@Override", "@Deprecated", "@SuppressWarnings"], "ans": 0, "why": ["Correct option: `@FunctionalInterface` enables compiler checking of the single-abstract-method contract.", "Incorrect option: `@Override` applies to overriding methods.", "Incorrect option: `@Deprecated` marks API for discouragement/removal.", "Incorrect option: `@SuppressWarnings` suppresses selected compiler warnings."], "lesson": "A functional interface has one abstract method. A lambda is a short way to provide that method's behaviour, such as a test, transformation, or action."}, {"topic": "Streams", "difficulty": "Easy", "q": "Which statement best distinguishes a Stream from a Collection?", "opts": ["A Stream stores elements permanently", "A Collection stores/manages data; a Stream describes a pipeline of computations over data", "A Stream is always parallel", "A Collection can never be iterated"], "ans": 1, "why": ["Incorrect option: A Stream is not generally a data-storage structure.", "Correct option: Collections manage data; streams process elements through a pipeline.", "Incorrect option: Streams are sequential by default unless parallel execution is requested or supplied.", "Incorrect option: Collections are iterable."], "lesson": "A Stream is a pipeline for processing data. Intermediate operations such as filter and map are lazy; a terminal operation such as count, reduce or forEach starts processing."}, {"topic": "Concurrency & threads", "difficulty": "Easy", "q": "Which method begins execution of a new thread?", "opts": ["run() called directly", "start()", "executeNow()", "init()"], "ans": 1, "why": ["Incorrect option: Calling `run()` directly is an ordinary method call on the current thread.", "Correct option: `start()` asks the JVM to schedule a new thread; that thread invokes `run()`.", "Incorrect option: There is no Thread.executeNow method.", "Incorrect option: `init()` is not the Thread start method."], "lesson": "Calling start() asks Java to run a task on a new thread; calling run() directly is just a normal method call. Shared mutable data needs coordination."}, {"topic": "File handling & serialization", "difficulty": "Easy", "q": "Which package contains classic stream-based file I/O classes such as FileInputStream?", "opts": ["java.net", "java.io", "java.sql", "java.awt"], "ans": 1, "why": ["Incorrect option: `java.net` contains networking APIs.", "Correct option: `java.io` contains stream and file I/O classes.", "Incorrect option: `java.sql` contains JDBC APIs.", "Incorrect option: `java.awt` contains GUI/graphics APIs."], "lesson": "File I/O reads and writes data. Serialization writes an object's state to a stream; transient fields are skipped by default serialization."}, {"topic": "JDBC", "difficulty": "Easy", "q": "What is JDBC?", "opts": ["A Java API for database connectivity", "A Java GUI framework", "A JVM garbage collector", "A Java source-code formatter"], "ans": 0, "why": ["Correct option: JDBC provides APIs to connect to databases and execute SQL statements.", "Incorrect option: Swing/JavaFX are GUI technologies.", "Incorrect option: Garbage collection is a JVM memory-management function.", "Incorrect option: Formatting is not JDBC's purpose."], "lesson": "JDBC connects Java code to a database. Connection represents the session, PreparedStatement executes parameterized SQL, and ResultSet represents query rows."}, {"topic": "Data types & variables", "difficulty": "Easy", "q": "What is the default value of an instance field of type int?", "opts": ["0", "null", "Undefined garbage value", "Compilation error"], "ans": 0, "why": ["Correct option: Numeric instance fields are default-initialized to zero.", "Incorrect option: `null` is the default for reference fields, not primitive `int` fields.", "Incorrect option: Java initializes fields; local variables, in contrast, must be definitely assigned before use.", "Incorrect option: Declaring an instance `int` field without an initializer is valid."], "lesson": "Primitive variables store simple values such as numbers and booleans. Reference variables store a reference to an object. Fields get default values; local variables must be assigned before use."}, {"topic": "Operators & control flow", "difficulty": "Easy", "q": "In a traditional switch statement, what happens if a matching case has no break?", "opts": ["The switch immediately exits", "Execution falls through into subsequent case sections", "The program does not compile", "The default case runs first"], "ans": 1, "why": ["Incorrect option: Without `break`, execution normally continues into following statement groups.", "Correct option: Fall-through is the classic behaviour of colon-style switch labels.", "Incorrect option: Missing `break` is legal, though it may be unintended.", "Incorrect option: The default label is considered only if no case matches; it does not run first."], "lesson": "Java evaluates most expressions from left to right. Post-increment uses the old value and then increments; pre-increment increments first. && and || can skip the right-hand expression."}, {"topic": "OOP & object lifecycle", "difficulty": "Easy", "q": "What happens after `Student s1 = new Student(); Student s2=s1;`?", "opts": ["Two Student objects exist", "Both references refer to the same object", "s2 is a deep copy of s1", "s1 becomes null"], "ans": 1, "why": ["Incorrect option: Only one `new` expression creates an object.", "Correct option: Assignment copies the reference value; both variables designate the same object.", "Incorrect option: A shallow/deep copy requires explicit copying logic or a copy constructor.", "Incorrect option: Assigning s1 to s2 does not change s1."], "lesson": "A variable holding an object reference does not contain the whole object. Assigning one reference to another copies the reference, so both can point to the same object."}, {"topic": "Encapsulation & access", "difficulty": "Easy", "q": "Which access modifier allows access only within the declaring class?", "opts": ["public", "protected", "default (package-private)", "private"], "ans": 3, "why": ["Incorrect option: `public` is accessible wherever the declaring type/member is accessible.", "Incorrect option: `protected` permits package access and subclass access subject to rules.", "Incorrect option: Package-private permits access within the same package.", "Correct option: `private` restricts access to the declaring top-level class's body (including its nested types' access rules)."], "lesson": "Encapsulation protects an object's internal data. private members are accessible inside their declaring class; public members can be accessed wherever the class is accessible."}, {"topic": "Methods & constructors", "difficulty": "Easy", "q": "What is true about a constructor?", "opts": ["It has a return type of void", "It must have the same name as its class and has no return type", "It is inherited by subclasses", "It can be abstract"], "ans": 1, "why": ["Incorrect option: Constructors do not declare any return type, not even `void`.", "Correct option: A constructor name matches the class name and it has no return type.", "Incorrect option: Constructors are not inherited.", "Incorrect option: Constructors cannot be abstract because they initialize concrete instances."], "lesson": "Overloading means the same method name with different parameter lists. Java chooses an overload at compile time. Constructors initialize objects and have the class name with no return type."}, {"topic": "Immutability & inheritance", "difficulty": "Easy", "q": "Which statement about Java class inheritance is correct?", "opts": ["A class can extend multiple classes", "A class can extend one class directly", "An interface cannot extend another interface", "Constructors are inherited"], "ans": 1, "why": ["Incorrect option: Java classes support single class inheritance, not multiple class inheritance.", "Correct option: A class has at most one direct superclass (other than `Object`).", "Incorrect option: Interfaces can extend multiple interfaces.", "Incorrect option: Constructors are not inherited."], "lesson": "Inheritance lets a subclass reuse and specialize a superclass. An immutable object cannot have its observable state changed after construction."}, {"topic": "Immutability & inheritance", "difficulty": "Easy", "q": "What is an abstract class?", "opts": ["A class that cannot contain concrete methods", "A class that cannot be instantiated directly and may declare abstract methods", "An interface with fields only", "A class that must be final"], "ans": 1, "why": ["Incorrect option: Abstract classes can contain concrete methods, fields and constructors.", "Correct option: An abstract class cannot be instantiated directly; subclasses may implement its abstract methods.", "Incorrect option: An abstract class is not simply an interface.", "Incorrect option: A class cannot be both abstract and final because those intents conflict."], "lesson": "Inheritance lets a subclass reuse and specialize a superclass. An immutable object cannot have its observable state changed after construction."}, {"topic": "Exception handling", "difficulty": "Easy", "q": "Which is a checked exception?", "opts": ["NullPointerException", "ArithmeticException", "IOException", "ArrayIndexOutOfBoundsException"], "ans": 2, "why": ["Incorrect option: `NullPointerException` is unchecked (a RuntimeException).", "Incorrect option: `ArithmeticException` is unchecked.", "Correct option: `IOException` is checked and must be caught or declared, subject to context.", "Incorrect option: `ArrayIndexOutOfBoundsException` is unchecked."], "lesson": "An exception interrupts normal flow. A matching catch handles it; finally is used for cleanup. Checked exceptions must be caught or declared, while RuntimeException subclasses are unchecked."}, {"topic": "Strings", "difficulty": "Easy", "q": "What is printed? `String s=\"Java\"; s.concat(\"17\"); System.out.println(s);`", "opts": ["Java17", "Java", "17", "null"], "ans": 1, "why": ["Incorrect option: `concat` returns a new String; ignoring that result leaves `s` unchanged.", "Correct option: String is immutable, so the original reference still denotes `Java`.", "Incorrect option: The returned concatenated string is not printed.", "Incorrect option: The variable is not null."], "lesson": "String objects cannot be changed after creation. Methods such as concat and toUpperCase return a new String; they do not modify the original String variable automatically."}, {"topic": "Collections - List/Set/Map", "difficulty": "Easy", "q": "Which collection rejects duplicate elements?", "opts": ["ArrayList", "LinkedList", "Set", "Vector"], "ans": 2, "why": ["Incorrect option: Lists preserve duplicates.", "Incorrect option: LinkedList implements List and permits duplicates.", "Correct option: The Set contract models unique elements.", "Incorrect option: Vector is a List and permits duplicates."], "lesson": "List keeps elements in a sequence and allows duplicates. Set prevents duplicates. Map stores key-value pairs and each key can map to only one current value."}, {"topic": "Enums, wrappers & annotations", "difficulty": "Easy", "q": "What is autoboxing?", "opts": ["Converting a wrapper object to a primitive", "Automatically converting a primitive to its corresponding wrapper type", "Converting any object to String", "Serializing an object"], "ans": 1, "why": ["Incorrect option: Wrapper-to-primitive conversion is unboxing.", "Correct option: Autoboxing converts e.g. `int` to `Integer` automatically.", "Incorrect option: String conversion is unrelated.", "Incorrect option: Serialization writes object state to a stream."], "lesson": "Enums define a fixed set of named constants. Wrapper classes represent primitive values as objects; autoboxing and unboxing convert between the two forms."}, {"topic": "Concurrency & threads", "difficulty": "Easy", "q": "Which interface is commonly implemented to define a task for a Thread?", "opts": ["Serializable", "Runnable", "Comparable", "AutoCloseable"], "ans": 1, "why": ["Incorrect option: Serializable marks objects for serialization.", "Correct option: Runnable defines the `run()` task method.", "Incorrect option: Comparable defines natural ordering.", "Incorrect option: AutoCloseable supports resource closure."], "lesson": "Calling start() asks Java to run a task on a new thread; calling run() directly is just a normal method call. Shared mutable data needs coordination."}, {"topic": "Generics & collections", "difficulty": "Medium", "q": "What happens?\n```java\nList<? extends Number> nums = new ArrayList<Integer>();\nnums.add(10);\n```", "opts": ["Compiles and adds 10", "Compilation error", "ClassCastException", "NullPointerException"], "ans": 1, "why": ["Incorrect option: The exact subtype represented by the wildcard is unknown; adding Integer may be unsafe.", "Correct option: The compiler rejects adding a non-null value to a `? extends Number` collection.", "Incorrect option: This is a compile-time type-safety restriction, not a runtime cast.", "Incorrect option: No null dereference occurs."], "lesson": "Generics let the compiler check what types a collection can contain. With `? extends T`, reading as T is safe; with `? super T`, adding T is safe."}, {"topic": "Data types & variables", "difficulty": "Medium", "q": "What happens?\n```java\npublic class Test {\n  public static void main(String[] args) {\n    int x;\n    if (args.length > 0) x = 10;\n    System.out.println(x);\n  }\n}\n```", "opts": ["Prints 10", "Prints 0", "Compilation error", "Throws NullPointerException"], "ans": 2, "why": ["Incorrect option: The assignment occurs only conditionally; the compiler cannot prove x is assigned on every path.", "Incorrect option: Local variables do not receive the default field value 0.", "Correct option: Java's definite-assignment analysis rejects the read of x because args may be empty.", "Incorrect option: No dereference of a null reference occurs here."], "lesson": "Primitive variables store simple values such as numbers and booleans. Reference variables store a reference to an object. Fields get default values; local variables must be assigned before use."}, {"topic": "Exception handling", "difficulty": "Medium", "q": "What is printed?\n```java\nstatic int test() {\n  try { return 1; }\n  finally { return 2; }\n}\nSystem.out.println(test());\n```", "opts": ["1", "2", "Compilation error", "No output"], "ans": 1, "why": ["Incorrect option: The pending return from try is overridden by the return in finally.", "Correct option: A return from finally replaces the earlier return value.", "Incorrect option: This code compiles, although returning from finally is discouraged.", "Incorrect option: The method returns normally with 2."], "lesson": "An exception interrupts normal flow. A matching catch handles it; finally is used for cleanup. Checked exceptions must be caught or declared, while RuntimeException subclasses are unchecked."}, {"topic": "Date & time API", "difficulty": "Medium", "q": "Which type is best suited to represent a machine timestamp on the UTC timeline?", "opts": ["LocalDate", "Instant", "MonthDay", "Year"], "ans": 1, "why": ["Incorrect option: LocalDate has no time or zone.", "Correct option: Instant represents a point on the UTC timeline.", "Incorrect option: MonthDay stores month and day only.", "Incorrect option: Year stores a year only."], "lesson": "The java.time classes are immutable. LocalDate is a date without a time zone; Instant represents a point on the UTC timeline; ZonedDateTime includes a time zone."}, {"topic": "Streams", "difficulty": "Medium", "q": "What is the output?\n```java\nList<Integer> values = List.of(1,2,3,4);\nvalues.stream().peek(System.out::print).limit(2).count();\n```", "opts": ["12", "1234", "No output", "The output is not guaranteed to be 12 because count may optimize away traversal"], "ans": 3, "why": ["Incorrect option: Although peek is often used for observation, the Stream implementation may elide stages when the terminal result can be computed without traversing elements.", "Incorrect option: The API permits eliding behavioural side effects in intermediate operations when they do not affect the result; count on a sized source can be optimized.", "Incorrect option: The source is not empty, but that does not require peek's side effects to execute.", "Correct option: This is the subtle API point: side effects in intermediate operations are not guaranteed to run."], "lesson": "A Stream is a pipeline for processing data. Intermediate operations such as filter and map are lazy; a terminal operation such as count, reduce or forEach starts processing."}, {"topic": "Strings", "difficulty": "Medium", "q": "What is printed?\n```java\nString s1 = \"cat\";\nString s2 = \"ca\" + \"t\";\nString s3 = new String(\"cat\");\nSystem.out.println((s1 == s2) + \":\" + (s1 == s3) + \":\" + s1.equals(s3));\n```", "opts": ["true:false:true", "false:false:true", "true:true:true", "false:true:false"], "ans": 0, "why": ["Correct option: Compile-time constant concatenation is interned, so s1 and s2 refer to the same pooled String.", "Incorrect option: s3 explicitly creates a distinct String object, so reference equality is false.", "Incorrect option: equals compares contents, so the final comparison is true.", "Incorrect option: The three comparisons are respectively true, false and true."], "lesson": "String objects cannot be changed after creation. Methods such as concat and toUpperCase return a new String; they do not modify the original String variable automatically."}, {"topic": "Concurrency & threads", "difficulty": "Medium", "q": "Which state means a thread is waiting indefinitely for another thread's action?", "opts": ["NEW", "RUNNABLE", "WAITING", "TERMINATED"], "ans": 2, "why": ["Incorrect option: NEW means created but not started.", "Incorrect option: RUNNABLE means eligible/running in JVM scheduling terms.", "Correct option: WAITING represents waiting indefinitely, e.g. Object.wait() without timeout or join() without timeout.", "Incorrect option: TERMINATED means execution has completed."], "lesson": "Calling start() asks Java to run a task on a new thread; calling run() directly is just a normal method call. Shared mutable data needs coordination."}, {"topic": "Methods & constructors", "difficulty": "Medium", "q": "Which overload is selected?\n```java\nstatic void show(Object x) { System.out.print(\"Object\"); }\nstatic void show(String x) { System.out.print(\"String\"); }\npublic static void main(String[] a) { show(null); }\n```", "opts": ["Object", "String", "Compilation error: null is ambiguous", "Runtime exception"], "ans": 1, "why": ["Incorrect option: String is more specific than Object, so overload resolution selects show(String).", "Correct option: The null literal can be converted to either type; the most specific applicable overload is String.", "Incorrect option: There is no ambiguity because String is a subtype of Object.", "Incorrect option: The call is resolved at compile time and does not throw at runtime."], "lesson": "Overloading means the same method name with different parameter lists. Java chooses an overload at compile time. Constructors initialize objects and have the class name with no return type."}, {"topic": "Strings", "difficulty": "Medium", "q": "What is the String pool mainly used for?", "opts": ["Store all mutable strings", "Reuse canonical String instances for equal string literals/interned strings", "Store only strings longer than 100 characters", "Replace the heap"], "ans": 1, "why": ["Incorrect option: String objects are immutable; the pool is not a mutable-string store.", "Correct option: The pool allows reuse of canonical String instances for literals and interned strings.", "Incorrect option: There is no such length rule.", "Incorrect option: The pool is part of heap-managed memory in modern JVMs; it does not replace the heap."], "lesson": "String objects cannot be changed after creation. Methods such as concat and toUpperCase return a new String; they do not modify the original String variable automatically."}, {"topic": "Operators & control flow", "difficulty": "Medium", "q": "Which is the output?\n```java\nint x = 3;\nswitch (x) {\n  case 1: System.out.print(\"A\");\n  case 2: System.out.print(\"B\");\n  case 3: System.out.print(\"C\");\n  default: System.out.print(\"D\");\n}\n```", "opts": ["C", "CD", "ABCD", "BCD"], "ans": 1, "why": ["Incorrect option: Colon-style cases fall through, so execution does not stop after C.", "Correct option: Case 3 matches, prints C, then falls through to default and prints D.", "Incorrect option: Execution begins at the matching case, not at case 1.", "Incorrect option: Cases 1 and 2 are skipped because x is 3."], "lesson": "Java evaluates most expressions from left to right. Post-increment uses the old value and then increments; pre-increment increments first. && and || can skip the right-hand expression."}, {"topic": "Date & time API", "difficulty": "Medium", "q": "Which Java time class represents a date without time or time zone?", "opts": ["LocalDate", "LocalTime", "Instant", "ZonedDateTime"], "ans": 0, "why": ["Correct option: `LocalDate` represents a calendar date without time or zone.", "Incorrect option: `LocalTime` represents time-of-day without date or zone.", "Incorrect option: `Instant` represents a point on the UTC timeline.", "Incorrect option: `ZonedDateTime` includes date, time and zone."], "lesson": "The java.time classes are immutable. LocalDate is a date without a time zone; Instant represents a point on the UTC timeline; ZonedDateTime includes a time zone."}, {"topic": "Interfaces & inner classes", "difficulty": "Medium", "q": "What is printed?\n```java\ninterface I { default void run(){System.out.print(\"I\");} }\nclass C implements I { public void run(){System.out.print(\"C\");} }\nI x = new C();\nx.run();\n```", "opts": ["I", "C", "IC", "Compilation error"], "ans": 1, "why": ["Incorrect option: The implementing class overrides the interface default method.", "Correct option: Runtime dispatch invokes C.run().", "Incorrect option: The default implementation is not also invoked automatically.", "Incorrect option: The implementation has public visibility, as required for interface methods."], "lesson": "An interface describes behaviour a class promises to provide. A class can implement multiple interfaces, and an overriding implementation supplies the actual behaviour."}, {"topic": "Packages & arrays", "difficulty": "Medium", "q": "What is printed?\n```java\nint[][] a = {{1,2,3},{4,5},{6}};\nSystem.out.println(a.length + \":\" + a[1].length + \":\" + a[0][2]);\n```", "opts": ["3:2:3", "3:3:3", "6:2:3", "3:2:2"], "ans": 0, "why": ["Correct option: The outer array has 3 rows, row 1 has 2 elements, and a[0][2] is 3.", "Incorrect option: The second row has length 2, not 3.", "Incorrect option: The outer array length is 3; rows are separate arrays.", "Incorrect option: The element at index 2 of the first row is 3."], "lesson": "An array has a fixed length after creation. Indexes start at 0, and a two-dimensional array is an array whose elements are themselves arrays."}, {"topic": "Data types & variables", "difficulty": "Medium", "q": "What is printed?\n```java\nbyte b = 127;\nb++;\nSystem.out.println(b);\n```", "opts": ["128", "-128", "127", "Compilation error"], "ans": 1, "why": ["Incorrect option: A byte cannot represent 128; increment uses narrowing assignment semantics and wraps to -128.", "Correct option: The incremented value overflows the signed 8-bit range and wraps to -128.", "Incorrect option: The value is incremented; it does not remain 127.", "Incorrect option: The increment statement is legal Java."], "lesson": "Primitive variables store simple values such as numbers and booleans. Reference variables store a reference to an object. Fields get default values; local variables must be assigned before use."}, {"topic": "Collections - List/Set/Map", "difficulty": "Medium", "q": "What is printed?\n```java\nMap<String,Integer> m = new HashMap<>();\nm.put(\"x\", 1);\nm.put(\"x\", 7);\nSystem.out.println(m.size() + \":\" + m.get(\"x\"));\n```", "opts": ["2:7", "1:7", "1:1", "2:1"], "ans": 1, "why": ["Incorrect option: Map keys are unique, so replacing a value does not add a second mapping.", "Correct option: The second put replaces the value for key x; there is one mapping with value 7.", "Incorrect option: The later put overwrites the earlier value.", "Incorrect option: A repeated key does not create two entries."], "lesson": "List keeps elements in a sequence and allows duplicates. Set prevents duplicates. Map stores key-value pairs and each key can map to only one current value."}, {"topic": "Exception handling", "difficulty": "Medium", "q": "What is the difference between `throw` and `throws`?", "opts": ["`throw` declares a method contract; `throws` creates an exception object", "`throw` actually throws an exception; `throws` declares possible exceptions in a method signature", "They are synonyms", "`throws` is used only in catch blocks"], "ans": 1, "why": ["Incorrect option: The roles are reversed in this option.", "Correct option: `throw` is a statement that throws a particular Throwable; `throws` appears in a declaration.", "Incorrect option: They are distinct language constructs.", "Incorrect option: `throws` belongs in method/constructor declarations, not catch blocks."], "lesson": "An exception interrupts normal flow. A matching catch handles it; finally is used for cleanup. Checked exceptions must be caught or declared, while RuntimeException subclasses are unchecked."}, {"topic": "Exception handling", "difficulty": "Medium", "q": "What must a custom checked exception normally extend?", "opts": ["RuntimeException", "Error", "Exception (but not RuntimeException)", "Object directly"], "ans": 2, "why": ["Incorrect option: Extending RuntimeException creates an unchecked exception.", "Incorrect option: Errors represent serious JVM/system conditions and are not ordinary application checked exceptions.", "Correct option: A class extending Exception but not RuntimeException is checked.", "Incorrect option: A direct Object subclass is not recognized as a throwable type."], "lesson": "An exception interrupts normal flow. A matching catch handles it; finally is used for cleanup. Checked exceptions must be caught or declared, while RuntimeException subclasses are unchecked."}, {"topic": "Methods & constructors", "difficulty": "Medium", "q": "What is printed?\n```java\nclass A { void f(Number n){System.out.print(\"N\");} }\nclass B extends A { void f(Integer i){System.out.print(\"I\");} }\nA ref = new B();\nref.f(10);\n```", "opts": ["I", "N", "NI", "Compilation error"], "ans": 1, "why": ["Incorrect option: The declared reference type A determines the overload set; A.f(Number) is selected.", "Correct option: Overloading is resolved at compile time using A's visible methods; B's Integer overload is not an override.", "Incorrect option: Only one overload is invoked.", "Incorrect option: The call is valid because int 10 can be boxed to Integer and widened to Number."], "lesson": "Overloading means the same method name with different parameter lists. Java chooses an overload at compile time. Constructors initialize objects and have the class name with no return type."}, {"topic": "Functional programming & lambdas", "difficulty": "Medium", "q": "What is printed?\n```java\nPredicate<String> p = s -> s.length() > 3;\nSystem.out.println(p.test(\"Java\") + \":\" + p.test(\"JVM\"));\n```", "opts": ["true:true", "true:false", "false:true", "false:false"], "ans": 1, "why": ["Incorrect option: Java has length 4, and JVM has length 3.", "Correct option: The predicate is true for Java and false for JVM.", "Incorrect option: JVM does not exceed length 3.", "Incorrect option: Java exceeds the threshold."], "lesson": "A functional interface has one abstract method. A lambda is a short way to provide that method's behaviour, such as a test, transformation, or action."}, {"topic": "Immutability & inheritance", "difficulty": "Medium", "q": "Which design choice helps make a class immutable?", "opts": ["Expose all fields as public", "Provide setters for every field", "Make the class final (where appropriate), fields private final, and avoid leaking mutable state", "Return internal mutable collections directly"], "ans": 2, "why": ["Incorrect option: Public fields allow external mutation.", "Incorrect option: Setters allow state changes after construction.", "Correct option: This is a common immutable-class strategy; defensive copies are also needed for mutable inputs/outputs.", "Incorrect option: Returning internal mutable state lets callers modify it."], "lesson": "Inheritance lets a subclass reuse and specialize a superclass. An immutable object cannot have its observable state changed after construction."}, {"topic": "Java platform & JVM", "difficulty": "Medium", "q": "What makes the same Java bytecode portable across operating systems?", "opts": ["The bytecode contains every operating system's native instructions", "A compatible JVM exists on each target platform", "The source file is interpreted by the CPU directly", "The JDK converts bytecode to HTML"], "ans": 1, "why": ["Incorrect option: Bytecode is platform-neutral; it is not a bundle of all native instruction sets.", "Correct option: Each platform provides a JVM implementation that understands the same class-file format and executes it.", "Incorrect option: The CPU does not directly execute Java bytecode as native machine instructions.", "Incorrect option: HTML has no role in Java bytecode portability."], "lesson": "Think of the JDK as the developer's toolbox, the JVM as the engine that runs bytecode, and javac as the compiler that turns .java source into .class bytecode."}, {"topic": "Streams", "difficulty": "Medium", "q": "What is printed?\n```java\nint result = Stream.of(1,2,3,4)\n    .filter(x -> x % 2 == 0)\n    .map(x -> x * x)\n    .reduce(0, Integer::sum);\nSystem.out.println(result);\n```", "opts": ["6", "20", "10", "30"], "ans": 1, "why": ["Incorrect option: Filtering leaves 2 and 4; squaring gives 4 and 16.", "Correct option: Reduction sums 4 + 16 using identity 0, giving 20.", "Incorrect option: 10 would be the sum of original even values, before squaring.", "Incorrect option: 30 is the sum of all squares, but odd values are filtered out."], "lesson": "A Stream is a pipeline for processing data. Intermediate operations such as filter and map are lazy; a terminal operation such as count, reduce or forEach starts processing."}, {"topic": "JDBC", "difficulty": "Medium", "q": "What is the main issue with this code?\n```java\nString sql = \"SELECT * FROM users WHERE name='\" + input + \"'\";\nStatement st = con.createStatement();\nResultSet rs = st.executeQuery(sql);\n```", "opts": ["It cannot execute SELECT statements", "User input can alter SQL syntax, creating SQL injection risk", "ResultSet is not used for SELECT", "Statement always closes the connection"], "ans": 1, "why": ["Incorrect option: Statement can execute SELECT and return a ResultSet.", "Correct option: Concatenating untrusted input into SQL allows malicious input to change the query structure.", "Incorrect option: SELECT results are returned in a ResultSet.", "Incorrect option: Closing a Statement does not mean it always closes the Connection; resource closure must be managed."], "lesson": "JDBC connects Java code to a database. Connection represents the session, PreparedStatement executes parameterized SQL, and ResultSet represents query rows."}, {"topic": "Collections - List/Set/Map", "difficulty": "Medium", "q": "What is printed?\n```java\nList<Integer> xs = new ArrayList<>(List.of(1,2,3));\nxs.remove(Integer.valueOf(2));\nSystem.out.println(xs);\n```", "opts": ["[1, 3]", "[2, 3]", "[1, 2]", "[1, 2, 3]"], "ans": 0, "why": ["Correct option: `remove(Object)` removes the matching value 2.", "Incorrect option: The call passes an Integer object, not an int index.", "Incorrect option: The value 2 is removed, leaving 1 and 3.", "Incorrect option: The list is mutated."], "lesson": "List keeps elements in a sequence and allows duplicates. Set prevents duplicates. Map stores key-value pairs and each key can map to only one current value."}, {"topic": "Packages & arrays", "difficulty": "Medium", "q": "What does the classpath tell Java tools?", "opts": ["Where to find classes and packages", "How much heap memory to allocate", "Which CPU instruction set to use", "Which garbage collector must run"], "ans": 0, "why": ["Correct option: The classpath identifies locations (directories, JARs, modules in relevant contexts) used to locate classes and resources.", "Incorrect option: Heap sizing is controlled by JVM options such as `-Xmx`.", "Incorrect option: Classpath does not select processor instructions.", "Incorrect option: Garbage collector selection uses JVM options, not classpath."], "lesson": "An array has a fixed length after creation. Indexes start at 0, and a two-dimensional array is an array whose elements are themselves arrays."}, {"topic": "File handling & serialization", "difficulty": "Medium", "q": "Which interface must a class implement for default Java object serialization?", "opts": ["Cloneable", "Serializable", "Runnable", "Comparable"], "ans": 1, "why": ["Incorrect option: Cloneable is a marker interface related to Object.clone semantics.", "Correct option: Serializable is the marker interface used by Java's object serialization mechanism.", "Incorrect option: Runnable defines a task.", "Incorrect option: Comparable defines natural ordering."], "lesson": "File I/O reads and writes data. Serialization writes an object's state to a stream; transient fields are skipped by default serialization."}, {"topic": "Polymorphism & casting", "difficulty": "Medium", "q": "What is printed?\n```java\nclass A { int x = 1; void print(){System.out.print(\"A\");} }\nclass B extends A { int x = 2; @Override void print(){System.out.print(\"B\");} }\nA ref = new B();\nSystem.out.print(ref.x);\nref.print();\n```", "opts": ["1A", "2B", "1B", "2A"], "ans": 2, "why": ["Incorrect option: Field access uses the declared reference type, so ref.x is 1.", "Incorrect option: The overridden instance method uses runtime dispatch, so print() is B.", "Correct option: The output combines field hiding (1) with virtual method dispatch (B).", "Incorrect option: The method is overridden and dynamically dispatched; it is not selected by reference type."], "lesson": "The reference type controls which members are visible at compile time. For overridden instance methods, the actual object's class chooses the implementation at runtime."}, {"topic": "OOP & object lifecycle", "difficulty": "Medium", "q": "What is printed?\n```java\nclass Box { int value = 1; }\nBox a = new Box();\nBox b = a;\nb.value = 9;\na = new Box();\nSystem.out.println(a.value + \":\" + b.value);\n```", "opts": ["1:9", "9:9", "1:1", "9:1"], "ans": 0, "why": ["Correct option: `a` is reassigned to a new Box whose value is 1; b still refers to the original object with value 9.", "Incorrect option: The new object assigned to a is distinct from the old object referenced by b.", "Incorrect option: The old object's value was changed through b.", "Incorrect option: The two references no longer point to the same object after reassignment."], "lesson": "A variable holding an object reference does not contain the whole object. Assigning one reference to another copies the reference, so both can point to the same object."}, {"topic": "Polymorphism & casting", "difficulty": "Medium", "q": "What is printed?\n```java\nObject o = \"hello\";\nif (o instanceof String s && s.length() == 5) {\n  System.out.println(s.toUpperCase());\n}\n```", "opts": ["HELLO", "hello", "true", "Compilation error"], "ans": 0, "why": ["Correct option: Pattern matching binds s as a String; the length check succeeds and uppercase conversion prints HELLO.", "Incorrect option: The code explicitly calls toUpperCase.", "Incorrect option: The println argument is the transformed String, not a boolean.", "Incorrect option: Pattern matching for instanceof is supported in Java 17."], "lesson": "The reference type controls which members are visible at compile time. For overridden instance methods, the actual object's class chooses the implementation at runtime."}, {"topic": "Java platform & JVM", "difficulty": "Medium", "q": "What is the usual relationship between JDK, runtime libraries and JVM?", "opts": ["JVM contains the JDK", "JDK includes development tools and a runtime; the JVM executes bytecode", "JRE is the compiler and debugger", "JDK and JVM are interchangeable names"], "ans": 1, "why": ["Incorrect option: The JVM is a component of the runtime, not a container for the entire JDK.", "Correct option: The JDK supplies tools such as `javac` plus the runtime components needed to run Java programs.", "Incorrect option: The runtime environment supplies libraries and the JVM; compilation/debugging tools belong to the JDK.", "Incorrect option: They refer to different layers and are not interchangeable."], "lesson": "Think of the JDK as the developer's toolbox, the JVM as the engine that runs bytecode, and javac as the compiler that turns .java source into .class bytecode."}, {"topic": "Concurrency & threads", "difficulty": "Medium", "q": "What is guaranteed about this code?\n```java\nThread t = new Thread(() -> System.out.print(\"R\"));\nt.run();\nSystem.out.print(\"M\");\n```", "opts": ["R and M print in a new thread, order arbitrary", "R prints on the current thread before M", "M always prints before R", "Compilation error"], "ans": 1, "why": ["Incorrect option: Calling run directly does not start a new thread.", "Correct option: run is an ordinary method call here, so R is printed synchronously before M.", "Incorrect option: The method call order guarantees R then M in the current thread.", "Incorrect option: The lambda is a valid Runnable."], "lesson": "Calling start() asks Java to run a task on a new thread; calling run() directly is just a normal method call. Shared mutable data needs coordination."}, {"topic": "Concurrency & threads", "difficulty": "Medium", "q": "What is the state sequence in a typical successful `Thread` execution?", "opts": ["NEW → RUNNABLE → TERMINATED", "NEW → WAITING → NEW", "RUNNABLE → NEW → TERMINATED", "NEW → TERMINATED → RUNNABLE"], "ans": 0, "why": ["Correct option: A thread begins NEW, becomes RUNNABLE after start, and eventually TERMINATED.", "Incorrect option: A terminated thread cannot return to NEW.", "Incorrect option: The state does not revert to NEW after start.", "Incorrect option: TERMINATED is the final lifecycle state."], "lesson": "Calling start() asks Java to run a task on a new thread; calling run() directly is just a normal method call. Shared mutable data needs coordination."}, {"topic": "Java platform & JVM", "difficulty": "Medium", "q": "Which command runs a compiled class named `Main` when its class files are in the current directory?", "opts": ["javac Main", "java Main", "javadoc Main", "jar Main"], "ans": 1, "why": ["Incorrect option: javac compiles source code; it does not launch the class.", "Correct option: java launches the class by its fully qualified name (assuming classpath and main method are correct).", "Incorrect option: javadoc generates documentation.", "Incorrect option: jar creates/manipulates archives."], "lesson": "Think of the JDK as the developer's toolbox, the JVM as the engine that runs bytecode, and javac as the compiler that turns .java source into .class bytecode."}, {"topic": "JDBC", "difficulty": "Medium", "q": "What does this code return from `executeUpdate()` for a successful INSERT?\n```java\nPreparedStatement ps = con.prepareStatement(\n  \"INSERT INTO employee(id,name) VALUES (?,?)\");\nps.setInt(1, 7);\nps.setString(2, \"Mira\");\nint n = ps.executeUpdate();\n```", "opts": ["A ResultSet", "An update count, commonly the number of rows affected", "The generated SQL string", "A Connection"], "ans": 1, "why": ["Incorrect option: executeUpdate does not return a ResultSet for an INSERT.", "Correct option: It returns an int update count, commonly 1 for one inserted row.", "Incorrect option: It does not return SQL text.", "Incorrect option: The connection is a separate JDBC object."], "lesson": "JDBC connects Java code to a database. Connection represents the session, PreparedStatement executes parameterized SQL, and ResultSet represents query rows."}, {"topic": "Streams", "difficulty": "Medium", "q": "What does `boxed()` do on an IntStream?", "opts": ["Converts Integer objects into int values", "Converts primitive int elements into Stream<Integer>", "Sorts the stream", "Makes the stream parallel"], "ans": 1, "why": ["Incorrect option: That is unboxing, not boxing.", "Correct option: `boxed()` wraps primitive int elements as Integer objects in a reference Stream.", "Incorrect option: Sorting requires `sorted()`.", "Incorrect option: Parallel execution is requested with `parallel()` or a parallel source."], "lesson": "A Stream is a pipeline for processing data. Intermediate operations such as filter and map are lazy; a terminal operation such as count, reduce or forEach starts processing."}, {"topic": "Date & time API", "difficulty": "Medium", "q": "What is printed?\n```java\nLocalDate d = LocalDate.of(2024, 2, 28);\nSystem.out.println(d.plusDays(1));\n```", "opts": ["2024-02-29", "2024-03-01", "2024-02-28", "DateTimeException"], "ans": 0, "why": ["Correct option: 2024 is a leap year, so the day after February 28 is February 29.", "Incorrect option: March 1 is the next day after February 29 in this leap year.", "Incorrect option: LocalDate is immutable; plusDays returns the next date.", "Incorrect option: The date is valid."], "lesson": "The java.time classes are immutable. LocalDate is a date without a time zone; Instant represents a point on the UTC timeline; ZonedDateTime includes a time zone."}, {"topic": "Strings", "difficulty": "Medium", "q": "What is printed?\n```java\nString s = \"java\";\ns = s.substring(0, 2).concat(\"VM\");\nSystem.out.println(s);\n```", "opts": ["javaVM", "jaVM", "JAVM", "VM"], "ans": 1, "why": ["Incorrect option: substring(0,2) returns ja, and concat appends VM.", "Correct option: The substring end index is exclusive, so only j and a are retained.", "Incorrect option: No uppercase conversion occurs.", "Incorrect option: The prefix is not empty."], "lesson": "String objects cannot be changed after creation. Methods such as concat and toUpperCase return a new String; they do not modify the original String variable automatically."}, {"topic": "Interfaces & inner classes", "difficulty": "Medium", "q": "Which statement about interfaces in modern Java is true?", "opts": ["Interfaces can contain default and static methods", "Interfaces can have ordinary per-instance constructors", "A class can implement only one interface", "Interfaces cannot declare constants"], "ans": 0, "why": ["Correct option: Java interfaces support abstract, default, static and (since Java 9) private methods, among other members.", "Incorrect option: Interfaces are not instantiated and have no constructors.", "Incorrect option: A class can implement multiple interfaces.", "Incorrect option: Interface fields are implicitly `public static final` constants."], "lesson": "An interface describes behaviour a class promises to provide. A class can implement multiple interfaces, and an overriding implementation supplies the actual behaviour."}, {"topic": "Streams", "difficulty": "Medium", "q": "What is the result?\n```java\nboolean b = Stream.of(2,4,6).anyMatch(x -> x % 2 != 0);\nSystem.out.println(b);\n```", "opts": ["true", "false", "Compilation error", "Optional.empty"], "ans": 1, "why": ["Incorrect option: No element is odd, so no predicate evaluation succeeds.", "Correct option: anyMatch returns false when no element matches.", "Incorrect option: The predicate is valid and returns boolean.", "Incorrect option: anyMatch returns a boolean, not an Optional."], "lesson": "A Stream is a pipeline for processing data. Intermediate operations such as filter and map are lazy; a terminal operation such as count, reduce or forEach starts processing."}, {"topic": "File handling & serialization", "difficulty": "Medium", "q": "What does `ObjectInputStream.readObject()` generally return?", "opts": ["A primitive int", "Object, requiring a cast or pattern match for a specific class", "Always Serializable at compile time", "A File object"], "ans": 1, "why": ["Incorrect option: readObject returns a reference, not a primitive int.", "Correct option: Its declared return type is Object; callers commonly cast to the expected type.", "Incorrect option: The runtime object must have been serialized appropriately, but the static return type is Object.", "Incorrect option: The returned object need not be a File."], "lesson": "File I/O reads and writes data. Serialization writes an object's state to a stream; transient fields are skipped by default serialization."}, {"topic": "Exception handling", "difficulty": "Hard", "q": "What is printed?\n```java\ntry {\n  System.out.print(\"T\");\n  int n = 10 / 0;\n  System.out.print(\"X\");\n} catch (ArithmeticException e) {\n  System.out.print(\"C\");\n} finally {\n  System.out.print(\"F\");\n}\n```", "opts": ["TXCF", "TCF", "TF", "C"], "ans": 1, "why": ["Incorrect option: The division throws before X can be printed.", "Correct option: T prints, division throws, catch prints C, and finally prints F.", "Incorrect option: Finally runs after the catch; it does not skip the catch.", "Incorrect option: The try block prints T before throwing."], "lesson": "An exception interrupts normal flow. A matching catch handles it; finally is used for cleanup. Checked exceptions must be caught or declared, while RuntimeException subclasses are unchecked."}, {"topic": "Methods & constructors", "difficulty": "Hard", "q": "What is printed?\n```java\nclass Base { Base(){ show(); } void show(){System.out.print(\"Base\");} }\nclass Sub extends Base { int x=7; @Override void show(){System.out.print(x);} }\nnew Sub();\n```", "opts": ["7", "0", "Base", "Compilation error"], "ans": 1, "why": ["Incorrect option: The subclass field initializer runs after the superclass constructor, so it has not yet assigned 7 when the overridden method is called.", "Correct option: During superclass construction, dynamic dispatch invokes Sub.show while x still has its default int value 0.", "Incorrect option: The override is invoked rather than Base.show.", "Incorrect option: Calling an overridable method from a constructor compiles, though it is a risky design."], "lesson": "Overloading means the same method name with different parameter lists. Java chooses an overload at compile time. Constructors initialize objects and have the class name with no return type."}, {"topic": "Exception handling", "difficulty": "Hard", "q": "What is printed?\n```java\ntry {\n  System.out.print(\"A\");\n  throw new RuntimeException();\n} finally {\n  System.out.print(\"B\");\n}\n```", "opts": ["A", "AB, then exception propagates", "B only", "AB and exception is swallowed"], "ans": 1, "why": ["Incorrect option: A prints before the exception is thrown.", "Correct option: Finally prints B, then because it does not handle/override the exception, the RuntimeException propagates.", "Incorrect option: The finally block runs after A has printed.", "Incorrect option: A finally block does not automatically swallow an exception."], "lesson": "An exception interrupts normal flow. A matching catch handles it; finally is used for cleanup. Checked exceptions must be caught or declared, while RuntimeException subclasses are unchecked."}, {"topic": "Strings", "difficulty": "Hard", "q": "What is printed?\n```java\nStringBuilder b = new StringBuilder(\"abc\");\nStringBuilder c = b.append(\"d\");\nc.insert(0, \"X\");\nSystem.out.println(b);\n```", "opts": ["abcd", "Xabcd", "Xabc", "Compilation error"], "ans": 1, "why": ["Incorrect option: append mutates the builder; c refers to the same builder as b.", "Correct option: Both references point to the same mutable object, so insert through c changes what b observes.", "Incorrect option: The inserted X is at index 0, before the original content.", "Incorrect option: StringBuilder methods return the same builder for chaining."], "lesson": "String objects cannot be changed after creation. Methods such as concat and toUpperCase return a new String; they do not modify the original String variable automatically."}, {"topic": "Polymorphism & casting", "difficulty": "Hard", "q": "What happens?\n```java\nclass Animal {}\nclass Dog extends Animal {}\nAnimal a = new Animal();\nDog d = (Dog) a;\n```", "opts": ["Successful cast", "ClassCastException at runtime", "Compilation error", "NullPointerException"], "ans": 1, "why": ["Incorrect option: The actual object is an Animal, not a Dog.", "Correct option: The cast is allowed by the compiler but fails its runtime type check.", "Incorrect option: The types are cast-convertible, so this is not necessarily a compile-time error.", "Incorrect option: The reference is non-null; the failure is a type mismatch."], "lesson": "The reference type controls which members are visible at compile time. For overridden instance methods, the actual object's class chooses the implementation at runtime."}, {"topic": "Streams", "difficulty": "Hard", "q": "What is printed?\n```java\nlong n = Stream.of(\"a\", \"bb\", \"ccc\")\n    .filter(s -> { System.out.print(\"F\"); return s.length() > 1; })\n    .count();\nSystem.out.println(\"=\" + n);\n```", "opts": ["F=2", "FFF=2", "No output because filter is lazy", "FF=2"], "ans": 1, "why": ["Incorrect option: count is terminal and evaluates the pipeline for all three elements, so F is printed three times.", "Correct option: The filter runs once per source element; two pass, then count prints 2.", "Incorrect option: The pipeline is lazy only until a terminal operation is invoked.", "Incorrect option: There are three source elements, so the predicate executes three times."], "lesson": "A Stream is a pipeline for processing data. Intermediate operations such as filter and map are lazy; a terminal operation such as count, reduce or forEach starts processing."}, {"topic": "Generics & collections", "difficulty": "Hard", "q": "What is printed?\n```java\nList<String> names = new ArrayList<>();\nnames.add(\"A\");\nList raw = names;\nraw.add(42);\nSystem.out.println(names.get(1));\n```", "opts": ["42", "A", "ClassCastException", "Compilation error at raw.add"], "ans": 2, "why": ["Incorrect option: The compiler inserts a cast to String when retrieving through the parameterized reference; the Integer cannot be cast to String.", "Incorrect option: The first element is A; the second element is the problematic Integer.", "Correct option: Raw types bypass generic checks at the raw operation, and the compiler-generated cast fails at retrieval.", "Incorrect option: The raw add compiles with an unchecked warning, not an error."], "lesson": "Generics let the compiler check what types a collection can contain. With `? extends T`, reading as T is safe; with `? super T`, adding T is safe."}, {"topic": "Generics & collections", "difficulty": "Hard", "q": "What does this compile-time declaration permit?\n```java\nList<? super Integer> values = new ArrayList<Number>();\nvalues.add(10);\nObject x = values.get(0);\n```", "opts": ["Compilation error at add", "Compiles; add Integer is safe and read type is Object", "Compiles; read type is Integer", "Only null can be added"], "ans": 1, "why": ["Incorrect option: `? super Integer` permits adding Integer values.", "Correct option: The exact list type could be List<Integer>, List<Number> or List<Object>; reading is safely typed only as Object.", "Incorrect option: The compiler cannot promise the retrieved value is Integer because the actual list could be List<Number> or List<Object>.", "Incorrect option: This is a lower-bounded wildcard, designed to accept Integer values."], "lesson": "Generics let the compiler check what types a collection can contain. With `? extends T`, reading as T is safe; with `? super T`, adding T is safe."}, {"topic": "Operators & control flow", "difficulty": "Hard", "q": "What is printed?\n```java\nint x = 0;\nboolean a = (x++ == 0) || (++x == 2);\nSystem.out.println(x + \":\" + a);\n```", "opts": ["1:true", "2:true", "2:false", "1:false"], "ans": 0, "why": ["Correct option: The left side is true after comparing old x=0; short-circuit OR skips the right side, leaving x=1.", "Incorrect option: The right operand is skipped, so x is not incremented again.", "Incorrect option: The expression is true because its left operand is true.", "Incorrect option: The boolean result is true."], "lesson": "Java evaluates most expressions from left to right. Post-increment uses the old value and then increments; pre-increment increments first. && and || can skip the right-hand expression."}, {"topic": "Concurrency & threads", "difficulty": "Hard", "q": "Which statement is correct?\n```java\nclass Counter { int n=0; void inc(){ n++; } }\n// Two threads each call inc() 100000 times.\n```", "opts": ["Final n is guaranteed to be 200000", "Final n may be less than 200000 due to a race condition", "Final n must be 100000", "Compilation fails because int is not thread-safe"], "ans": 1, "why": ["Incorrect option: Unsynchronized read-modify-write increments can be lost; the final value is not guaranteed.", "Correct option: Both threads can read the same old value and overwrite each other's increment.", "Incorrect option: Each thread performs 100000 increments, but interleavings can lose updates.", "Incorrect option: The code compiles; thread safety is a runtime correctness concern."], "lesson": "Calling start() asks Java to run a task on a new thread; calling run() directly is just a normal method call. Shared mutable data needs coordination."}, {"topic": "Generics & collections", "difficulty": "Hard", "q": "Which wildcard is commonly suitable when a method consumes Integer values into a List?", "opts": ["? extends Integer", "? super Integer", "? extends Number only", "?"], "ans": 1, "why": ["Incorrect option: `extends` is best for producers/read-only access; it restricts adding Integer safely.", "Correct option: `? super Integer` can refer to List<Integer>, List<Number> or List<Object>, so adding Integer is safe.", "Incorrect option: `? extends Number` does not permit safely adding Integer.", "Incorrect option: An unbounded wildcard does not allow adding Integer (except null)."], "lesson": "Generics let the compiler check what types a collection can contain. With `? extends T`, reading as T is safe; with `? super T`, adding T is safe."}, {"topic": "Enums, wrappers & annotations", "difficulty": "Hard", "q": "What happens?\n```java\nInteger a = 1000;\nInteger b = 1000;\nSystem.out.println(a == b);\n```", "opts": ["Always true", "Typically false; use equals for value comparison", "Compilation error", "Always false by Java specification"], "ans": 1, "why": ["Incorrect option: Integer caching is guaranteed for certain small values, not all values such as 1000.", "Correct option: For values outside the guaranteed cache range, separately boxed instances are typically distinct; compare wrapper values with equals.", "Incorrect option: The code compiles.", "Incorrect option: The specification does not guarantee false in every conceivable implementation context; value equality should use equals."], "lesson": "Enums define a fixed set of named constants. Wrapper classes represent primitive values as objects; autoboxing and unboxing convert between the two forms."}, {"topic": "Operators & control flow", "difficulty": "Hard", "q": "What is printed?\n```java\nint i = 0;\nfor (; i < 5; i++) {\n    if (i++ == 2) continue;\n    System.out.print(i);\n}\n```", "opts": ["1234", "1245", "135", "1345"], "ans": 2, "why": ["Incorrect option: The body increments i inside the condition and again in the for update; the output is not a simple sequence.", "Incorrect option: The condition's post-increment changes the loop counter before the print/update.", "Correct option: Trace: i=0 prints 1; i=2 condition compares 2 then increments to 3 and continues; update makes 4; next iteration prints 5. Output is 15. Correction: option C should be 15; see the execution trace.", "Incorrect option: The loop does not print 1345."], "lesson": "Java evaluates most expressions from left to right. Post-increment uses the old value and then increments; pre-increment increments first. && and || can skip the right-hand expression."}, {"topic": "Collections - List/Set/Map", "difficulty": "Hard", "q": "What happens?\n```java\nList<Integer> xs = new ArrayList<>(List.of(1,2,3));\nfor (Integer x : xs) {\n  if (x == 2) xs.remove(x);\n}\n```", "opts": ["Always completes safely", "May throw ConcurrentModificationException", "Compilation error", "Removes all elements"], "ans": 1, "why": ["Incorrect option: Modifying an ArrayList structurally during enhanced-for iteration is not safe.", "Correct option: The iterator detects structural modification and may throw ConcurrentModificationException on a subsequent iterator operation.", "Incorrect option: The syntax is valid.", "Incorrect option: The code does not remove all elements."], "lesson": "List keeps elements in a sequence and allows duplicates. Set prevents duplicates. Map stores key-value pairs and each key can map to only one current value."}, {"topic": "Functional programming & lambdas", "difficulty": "Hard", "q": "Which line compiles?\n```java\nint limit = 10;\n// choose the valid lambda assignment to Predicate<Integer> p\n```", "opts": ["Predicate<Integer> p = n -> n > limit;", "Predicate<Integer> p = n -> { limit++; return n > limit; };", "Predicate<Integer> p = (int n) -> n > limit++;", "Predicate<Integer> p = n -> n > 10 && limit++;"], "ans": 0, "why": ["Correct option: limit is effectively final, so it can be captured by the lambda.", "Incorrect option: The lambda attempts to modify a captured local variable, which is not allowed.", "Incorrect option: The post-increment also attempts to modify the captured local variable.", "Incorrect option: The right side of && must be boolean; limit++ is an int, and it modifies the captured variable."], "lesson": "A functional interface has one abstract method. A lambda is a short way to provide that method's behaviour, such as a test, transformation, or action."}, {"topic": "Streams", "difficulty": "Hard", "q": "What is printed?\n```java\nList<List<Integer>> data = List.of(List.of(1,2), List.of(3), List.of(4,5));\nlong count = data.stream().flatMap(List::stream).filter(x -> x % 2 == 1).count();\nSystem.out.println(count);\n```", "opts": ["2", "3", "5", "4"], "ans": 1, "why": ["Incorrect option: The flattened values are 1,2,3,4,5; odd values are 1,3,5, giving three.", "Correct option: There are three odd numbers in the flattened sequence.", "Incorrect option: The total flattened element count is five, not the filtered count.", "Incorrect option: Four is not the number of odd values."], "lesson": "A Stream is a pipeline for processing data. Intermediate operations such as filter and map are lazy; a terminal operation such as count, reduce or forEach starts processing."}, {"topic": "Exception handling", "difficulty": "Hard", "q": "What happens at compile time?\n```java\ntry {\n  throw new java.io.IOException();\n} catch (Exception e) {\n  System.out.println(\"caught\");\n} catch (java.io.IOException e) {\n  System.out.println(\"io\");\n}\n```", "opts": ["Prints caught", "Prints io", "Compilation error: second catch is unreachable", "Throws IOException at runtime"], "ans": 2, "why": ["Incorrect option: The first catch already catches IOException because it is a subclass of Exception.", "Incorrect option: The second catch cannot be reached for IOException after the broader Exception catch.", "Correct option: Java rejects a later catch whose exception type is already covered by an earlier catch.", "Incorrect option: The program fails compilation before runtime."], "lesson": "An exception interrupts normal flow. A matching catch handles it; finally is used for cleanup. Checked exceptions must be caught or declared, while RuntimeException subclasses are unchecked."}, {"topic": "Concurrency & threads", "difficulty": "Hard", "q": "What does this establish?\n```java\nsynchronized (lock) { shared = 42; }\n// Another thread later enters synchronized(lock) and reads shared.\n```", "opts": ["No visibility guarantee", "A happens-before relationship from the unlock to a subsequent lock on the same monitor", "Only atomicity for long values", "A new thread is created"], "ans": 1, "why": ["Incorrect option: Monitor synchronization provides visibility guarantees.", "Correct option: An unlock happens-before a subsequent lock on the same monitor, so the write is visible to the acquiring thread.", "Incorrect option: The guarantee is not limited to long values.", "Incorrect option: Synchronization does not create a thread."], "lesson": "Calling start() asks Java to run a task on a new thread; calling run() directly is just a normal method call. Shared mutable data needs coordination."}, {"topic": "Methods & constructors", "difficulty": "Hard", "q": "What is printed?\n```java\nclass A {\n  A() { this(5); System.out.print(\"A\"); }\n  A(int x) { System.out.print(x); }\n}\nnew A();\n```", "opts": ["A5", "5A", "5", "Compilation error"], "ans": 1, "why": ["Incorrect option: The delegated constructor executes first and prints 5; then the no-arg constructor body prints A.", "Correct option: Constructor chaining executes `this(5)` before the rest of the current constructor body.", "Incorrect option: Both constructor bodies run.", "Incorrect option: The `this(...)` invocation is correctly the first statement."], "lesson": "Overloading means the same method name with different parameter lists. Java chooses an overload at compile time. Constructors initialize objects and have the class name with no return type."}, {"topic": "OOP & object lifecycle", "difficulty": "Hard", "q": "Which object becomes eligible for garbage collection?\n```java\nObject x = new Object();\nObject y = new Object();\nx = y;\n```", "opts": ["The object originally assigned to x", "The object originally assigned to y", "Both objects", "Neither object"], "ans": 0, "why": ["Correct option: The first object loses its only shown reference when x is overwritten; assuming no other references, it is eligible.", "Incorrect option: The second object remains reachable through both x and y.", "Incorrect option: Only the first object becomes unreachable in this snippet.", "Incorrect option: The object now referenced by x and y remains reachable."], "lesson": "A variable holding an object reference does not contain the whole object. Assigning one reference to another copies the reference, so both can point to the same object."}, {"topic": "Concurrency & threads", "difficulty": "Hard", "q": "What can be concluded?\n```java\nThread t = new Thread(() -> {\n  try { Thread.sleep(100); }\n  catch (InterruptedException e) { Thread.currentThread().interrupt(); }\n});\nt.start();\nt.join();\nSystem.out.println(t.getState());\n```", "opts": ["NEW", "WAITING", "TERMINATED", "RUNNABLE"], "ans": 2, "why": ["Incorrect option: After start, the thread is no longer NEW.", "Incorrect option: join waits for completion; after it returns because the thread has completed, the target thread is TERMINATED.", "Correct option: The thread has finished executing its run method.", "Incorrect option: It is not still runnable after successful completion."], "lesson": "Calling start() asks Java to run a task on a new thread; calling run() directly is just a normal method call. Shared mutable data needs coordination."}, {"topic": "Immutability & inheritance", "difficulty": "Hard", "q": "What is printed?\n```java\nclass Parent { static void who(){System.out.print(\"P\");} }\nclass Child extends Parent { static void who(){System.out.print(\"C\");} }\nParent p = new Child();\np.who();\n```", "opts": ["P", "C", "PC", "Compilation error"], "ans": 0, "why": ["Correct option: Static method hiding is resolved using the compile-time reference type Parent.", "Incorrect option: The runtime object type does not dynamically dispatch static methods.", "Incorrect option: Only Parent.who is selected at this call site.", "Incorrect option: Static method hiding is legal Java."], "lesson": "Inheritance lets a subclass reuse and specialize a superclass. An immutable object cannot have its observable state changed after construction."}, {"topic": "Operators & control flow", "difficulty": "Hard", "q": "What is printed?\n```java\nint x = 10;\nSystem.out.println(x > 5 ? x < 8 ? 1 : 2 : 3);\n```", "opts": ["1", "2", "3", "Compilation error"], "ans": 1, "why": ["Incorrect option: The outer condition is true, then the nested condition x<8 is false.", "Correct option: The outer true branch is selected; the nested false branch yields 2.", "Incorrect option: The outer false branch is not evaluated.", "Incorrect option: Nested conditional expressions are valid Java."], "lesson": "Java evaluates most expressions from left to right. Post-increment uses the old value and then increments; pre-increment increments first. && and || can skip the right-hand expression."}, {"topic": "JDBC", "difficulty": "Hard", "q": "What is the likely result of this resource pattern?\n```java\ntry (Connection c = ds.getConnection();\n     PreparedStatement p = c.prepareStatement(\"SELECT id FROM t\");\n     ResultSet r = p.executeQuery()) {\n  while (r.next()) System.out.println(r.getInt(\"id\"));\n}\n```", "opts": ["Only ResultSet is closed", "Resources close automatically in reverse declaration order", "Connection remains open permanently", "Compilation error because resources cannot be nested"], "ans": 1, "why": ["Incorrect option: All declared AutoCloseable resources are closed at the end of the try block.", "Correct option: Try-with-resources closes in reverse order: ResultSet, PreparedStatement, then Connection.", "Incorrect option: The connection is closed as part of the resource list.", "Incorrect option: This is valid Java syntax."], "lesson": "JDBC connects Java code to a database. Connection represents the session, PreparedStatement executes parameterized SQL, and ResultSet represents query rows."}, {"topic": "File handling & serialization", "difficulty": "Hard", "q": "What is printed after deserialization?\n```java\nclass User implements Serializable {\n  String name = \"A\";\n  transient int pin = 1234;\n}\n// serialize new User(), then deserialize as User u\nSystem.out.println(u.name + \":\" + u.pin);\n```", "opts": ["A:1234", "A:0", "null:0", "Serialization fails"], "ans": 1, "why": ["Incorrect option: Transient fields are not restored from the serialized stream.", "Correct option: The serializable String field is restored; transient int receives its default value 0.", "Incorrect option: The name field is not transient and is serialized.", "Incorrect option: The class is serializable and the transient field alone does not cause failure."], "lesson": "File I/O reads and writes data. Serialization writes an object's state to a stream; transient fields are skipped by default serialization."}, {"topic": "OOP & object lifecycle", "difficulty": "Hard", "q": "What is printed?\n```java\nclass Node { Node next; }\nNode a = new Node();\nNode b = new Node();\na.next = b;\nb.next = a;\na = null;\nb = null;\n```", "opts": ["Both nodes are still reachable through next", "The two-node cycle is eligible for garbage collection", "Only a is collected; b remains reachable", "A cycle prevents garbage collection"], "ans": 1, "why": ["Incorrect option: After both external references are cleared, no root shown reaches either node.", "Correct option: A cycle alone does not keep objects alive; tracing garbage collectors collect unreachable cycles.", "Incorrect option: Neither node has an external reference in this snippet.", "Incorrect option: Modern garbage collectors are not simple reference-counting collectors and can reclaim cycles."], "lesson": "A variable holding an object reference does not contain the whole object. Assigning one reference to another copies the reference, so both can point to the same object."}, {"topic": "File handling & serialization", "difficulty": "Hard", "q": "What happens if `Person` implements Serializable but its non-transient field `Address address` does not implement Serializable?", "opts": ["Serialization always succeeds", "NotSerializableException may occur when serializing the Person object graph", "The address is silently skipped", "Address is automatically made transient"], "ans": 1, "why": ["Incorrect option: Default serialization follows non-transient references.", "Correct option: The referenced Address object is not serializable, so serialization can fail with NotSerializableException.", "Incorrect option: Only transient/static fields are skipped by default; this field is neither.", "Incorrect option: Java does not automatically change field modifiers."], "lesson": "File I/O reads and writes data. Serialization writes an object's state to a stream; transient fields are skipped by default serialization."}, {"topic": "Operators & control flow", "difficulty": "Hard", "q": "What is printed?\n```java\nint a = 4;\nint b = a++ + ++a * 2;\nSystem.out.println(a + \":\" + b);\n```", "opts": ["6:16", "6:14", "5:14", "6:18"], "ans": 0, "why": ["Correct option: `a++` yields 4 and leaves a=5; `++a` makes a=6 and yields 6; 4 + 6*2 = 16.", "Incorrect option: The multiplication is 6*2 and the earlier operand is 4, so b is 16, not 14.", "Incorrect option: The two increments leave a at 6, not 5.", "Incorrect option: No third increment occurs."], "lesson": "Java evaluates most expressions from left to right. Post-increment uses the old value and then increments; pre-increment increments first. && and || can skip the right-hand expression."}, {"topic": "Methods & constructors", "difficulty": "Hard", "q": "What happens?\n```java\nclass A {\n  A(int x) {}\n}\nclass B extends A {\n  B() {}\n}\n```", "opts": ["Compiles; implicit super() calls A()", "Compilation error because A has no no-argument constructor", "Runtime NoSuchMethodError", "B inherits A(int)"], "ans": 1, "why": ["Incorrect option: The compiler does not find an accessible no-argument superclass constructor.", "Correct option: B's implicit super() cannot be resolved because A declares only A(int).", "Incorrect option: This is detected at compile time, not runtime.", "Incorrect option: Constructors are not inherited."], "lesson": "Overloading means the same method name with different parameter lists. Java chooses an overload at compile time. Constructors initialize objects and have the class name with no return type."}, {"topic": "Java 17 language features", "difficulty": "Hard", "q": "What is printed?\n```java\nint n = 2;\nString result = switch (n) {\n  case 1 -> \"one\";\n  case 2 -> { yield \"two\"; }\n  default -> \"other\";\n};\nSystem.out.println(result);\n```", "opts": ["one", "two", "other", "Compilation error"], "ans": 1, "why": ["Incorrect option: Case 1 does not match.", "Correct option: The switch expression selects case 2; yield supplies the value two.", "Incorrect option: The default arm is used only when no case matches.", "Incorrect option: This switch expression and yield syntax are valid in Java 17."], "lesson": "Java 17 supports switch expressions, which produce a value. A block arm can use yield to provide that value."}];
const state = {index:0, answers:Array(QUESTIONS.length).fill(null), filter:"All"};
const $ = id => document.getElementById(id);
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
function fmt(s){return esc(s).replace(/`([^`]+)`/g,"<code>$1</code>").replace(/\n/g,"<br>");}
function filteredIndices(){return QUESTIONS.map((q,i)=>({q,i})).filter(x=>state.filter==="All"||x.q.difficulty===state.filter).map(x=>x.i);}
function currentQuestion(){return QUESTIONS[state.index];}
function render(){
 const q=currentQuestion(), chosen=state.answers[state.index], labels=["A","B","C","D"];
 $("qnum").textContent=`Question ${state.index+1} of ${QUESTIONS.length}`;
 $("difficulty").textContent=q.difficulty;$("difficulty").className=`tag ${q.difficulty}`;
 $("topic").textContent=q.topic;$("question").innerHTML=fmt(q.q);
 const stage = state.index < 30 ? "Stage 1 · Foundation (Easy)" : state.index < 70 ? "Stage 2 · Build confidence (Medium)" : "Stage 3 · Exam challenge (Hard)";
 $("lesson").innerHTML=`<div class="stage">${stage}</div><strong>Beginner concept note</strong>${esc(q.lesson)}${q.q.includes("```java")?`<p style="margin:7px 0 0;color:#aebed5">How to trace this code: start at the first line, update variable values as each line runs, and only then decide what the final print statement displays.</p>`:""}`;
 $("options").innerHTML=q.opts.map((o,i)=>{
  let cls="option";if(chosen!==null&&i===q.ans)cls+=" correct";else if(chosen!==null&&i===chosen&&chosen!==q.ans)cls+=" wrong";
  return `<div><button class="${cls}" data-option="${i}" ${chosen!==null?"disabled":""}><span class="letter">${labels[i]}</span><span class="opt">${fmt(o)}</span></button>${chosen!==null?`<div class="explanation ${i===q.ans?"good":i===chosen?"bad":""}"><strong>${i===q.ans?"Why this option is correct:":"Why this option is incorrect:"}</strong> ${esc(q.why[i])}</div>`:""}</div>`;
 }).join("");
 $("options").querySelectorAll("[data-option]").forEach(b=>b.addEventListener("click",()=>choose(Number(b.dataset.option))));
 if(chosen===null){$("feedback").innerHTML="";}else{
  const ok=chosen===q.ans;
  $("feedback").innerHTML=`<div class="feedback ${ok?"good":"bad"}"><b>${ok?"Correct answer!":"Not quite — the correct answer is "+labels[q.ans]+"."}</b><p>${ok?"Good work. Read all four explanations to understand why the other three choices do not fit.":"The correct answer and the reason each of the three alternatives is incorrect are shown below."}</p></div>`;
 }
 $("prev").disabled=state.index===0;$("next").disabled=state.index===QUESTIONS.length-1;
 updateStats();renderGrid();
}
function choose(i){if(state.answers[state.index]!==null)return;state.answers[state.index]=i;render();}
function updateStats(){
 const done=state.answers.filter(x=>x!==null).length, right=state.answers.reduce((n,a,i)=>n+(a===QUESTIONS[i].ans?1:0),0);
 $("answered").textContent=`${done} / ${QUESTIONS.length}`;$("correct").textContent=right;
 $("accuracy").textContent=done?Math.round(right/done*100)+"%":"—";$("remaining").textContent=QUESTIONS.length-done;
 $("progressbar").style.width=(done/QUESTIONS.length*100)+"%";
}
function renderGrid(){
 $("gridnums").innerHTML=QUESTIONS.map((q,i)=>{
  const a=state.answers[i],cls=(i===state.index?"current ":"")+(a===null?"":a===q.ans?"answered":"incorrect");
  return `<button class="num ${cls}" data-jump="${i}" aria-label="Go to question ${i+1}">${i+1}</button>`;
 }).join("");
 $("gridnums").querySelectorAll("[data-jump]").forEach(b=>b.addEventListener("click",()=>{state.index=Number(b.dataset.jump);render();}));
}
function move(delta){state.index=Math.max(0,Math.min(QUESTIONS.length-1,state.index+delta));render();}
$("prev").addEventListener("click",()=>move(-1));$("next").addEventListener("click",()=>move(1));
document.querySelectorAll(".filter").forEach(b=>b.addEventListener("click",()=>{
 document.querySelectorAll(".filter").forEach(x=>x.classList.remove("active"));b.classList.add("active");state.filter=b.dataset.filter;
 const list=filteredIndices();if(!list.includes(state.index))state.index=list[0]??0;render();
}));
$("reset").addEventListener("click",()=>{if(confirm("Clear all answers and restart the test?")){state.answers.fill(null);state.index=0;state.filter="All";document.querySelectorAll(".filter").forEach(b=>b.classList.toggle("active",b.dataset.filter==="All"));$("result").classList.remove("show");$("quiz").classList.remove("hidden");render();}});
function finish(){
 const done=state.answers.filter(x=>x!==null).length,right=state.answers.reduce((n,a,i)=>n+(a===QUESTIONS[i].ans?1:0),0),wrong=done-right,unanswered=QUESTIONS.length-done;
 const pct=Math.round(right/QUESTIONS.length*100);
 const incorrect=QUESTIONS.map((q,i)=>({q,i,a:state.answers[i]})).filter(x=>x.a!==x.q.ans);
 $("result").innerHTML=`<h2>Test results</h2><div class="scorebig">${right} / ${QUESTIONS.length}</div><p style="color:var(--muted);margin-top:0">Final score · ${pct}% of all questions</p>
 <div class="stats"><div class="stat"><strong>${done}</strong><span>Attempted</span></div><div class="stat"><strong>${wrong}</strong><span>Incorrect</span></div><div class="stat"><strong>${unanswered}</strong><span>Unanswered</span></div><div class="stat"><strong>${done?Math.round(right/done*100):0}%</strong><span>Accuracy attempted</span></div></div>
 <h3>Review questions to revisit</h3><div class="review">${incorrect.length?incorrect.map(x=>`<div class="reviewitem"><small>Q${x.i+1} · ${esc(x.q.difficulty)} · ${esc(x.q.topic)}</small><div><strong>${fmt(x.q.q)}</strong></div><p style="color:var(--muted);font-size:13px">Correct answer: ${"ABCD"[x.q.ans]} — ${fmt(x.q.opts[x.q.ans])}${x.a===null?" · Not attempted":""}</p><p style="font-size:13px">${esc(x.q.why[x.q.ans])}</p><button class="btn" data-review="${x.i}">Review question</button></div>`).join(""):"<p>Excellent — all attempted questions are correct.</p>"}</div>`;
 $("quiz").classList.add("hidden");$("result").classList.add("show");$("result").scrollIntoView({behavior:"smooth",block:"start"});
 $("result").querySelectorAll("[data-review]").forEach(b=>b.addEventListener("click",()=>{state.index=Number(b.dataset.review);$("result").classList.remove("show");$("quiz").classList.remove("hidden");render();window.scrollTo({top:0,behavior:"smooth"});}));
}
$("finish").addEventListener("click",finish);
render();
</script>
</body>
</html>